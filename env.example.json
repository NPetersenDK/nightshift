{
  "limits": { "session": 0.9, "week": 0.95, "maxTasksPerRun": 10 },
  "logRetentionDays": 14,
  "model": "sonnet",
  "models": { "simple": "haiku", "standard": "sonnet", "complex": "opus" },
  "worktreesRoot": "",
  "docker": {
    "enabled": true,
    "image": "ghcr.io/npetersendk/nightshift-agent:latest",
    "taskTimeoutMinutes": 360,
    "memory": "8g",
    "cpus": "4",
    "gitName": "Nightshift",
    "gitEmail": "nightshift@example.com"
  },
  "repos": {
    "my-frontend": { "url": "https://github.com/OWNER/my-frontend.git", "allowedTools": ["Bash(npm *)"] },
    "my-backend":  { "url": "https://github.com/OWNER/my-backend.git",  "allowedTools": ["Bash(dotnet *)"] }
  },
  "orgs": [
    {
      "name": "YOUR-AZURE-DEVOPS-ORG",
      "pat": "PAT-WITH-WORK-ITEMS-READ-WRITE (or set env AZDO_PAT)",
      "projects": [
        {
          "name": "YOUR-PROJECT",
          "team": "",
          "features": [
            { "name": "My product work", "repos": ["my-frontend", "my-backend"] }
          ]
        }
      ]
    }
  ]
}
